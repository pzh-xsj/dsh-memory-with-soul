{
  "name": "@local/dsh-memory-inject",
  "version": "0.1.0",
  "private": true,
  "description": "Inject the ~/.memory context block into every new DSH session through agent.inject().",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.0-rc.1 <0.3.0-0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
